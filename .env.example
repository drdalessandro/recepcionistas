# =========================================================================
# Biowellness Recepción — variables de entorno (ejemplo)
# Copiar a `.env` y completar. NUNCA commitear el .env real.
# =========================================================================

# --- Medplum (arrancamos en Medplum Cloud; portable a self-hosted) ---
# Base URL del servidor Medplum. Cloud: https://api.medplum.com/
MEDPLUM_BASE_URL=https://api.medplum.com/
# Credenciales de ClientApplication (client credentials) para seed y bots.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Project ID (opcional, para CLI multi-proyecto)
MEDPLUM_PROJECT_ID=

# --- Tipo de cambio por defecto (ARS/USD). Configurable por el admin. ---
# Valor de referencia del brief. Se almacena además como recurso FHIR (ver seed).
BW_TC_DEFAULT=1450

# --- Twilio (WhatsApp Business API) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número WhatsApp Business habilitado (formato whatsapp:+54911...)
TWILIO_WHATSAPP_FROM=

# --- Email transaccional: AWS SES ---
# El email se envía con medplum.sendEmail(), que usa el proveedor configurado en
# el servidor Medplum (AWS SES, región sa-east-1). El remitente REAL es el
# `supportEmail` del server Medplum (hola@medplum.com.ar), que debe ser una
# identidad SES verificada. No hacen falta credenciales de SES en el código.
# SES_FROM_EMAIL es opcional y SOLO lo usa `npm run email:test` para probar un
# remitente explícito; los bots NO lo setean (dejan que el server elija).
SES_FROM_EMAIL=hola@medplum.com.ar
# Remitente con marca para la invitación al portal (Project Secret en Medplum,
# lo lee bw-invitar-paciente). La dirección debe ser una identidad SES verificada.
EMAIL_FROM=Biowellness San Isidro <hola@medplum.com.ar>

# --- MercadoPago (cobros; tokeniza tarjetas, no almacenamos datos de tarjeta) ---
# Access Token de la aplicación (https://www.mercadopago.com.ar/developers):
#  · PRUEBA: credenciales de la cuenta/usuario de prueba — dinero ficticio.
#  · PRODUCCIÓN: credenciales productivas — LOS PAGOS SON REALES.
# Este .env lo usan solo los SCRIPTS (mp:test, mp:ordenes). Los BOTS leen su
# propio token de Project Secrets en Medplum: cambiarlo acá NO cambia el de los
# bots. El pasaje prueba→producción está en docs/puesta-en-produccion.md §7.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (panel MP → Webhooks → Modo productivo). Cargada
# como Project Secret, el bot valida la firma x-signature de cada notificación.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública del webhook de MP (bloque nginx /webhooks/mercadopago). La usa
# mp:test, y como Project Secret es OBLIGATORIA para generar links de pago.
MP_WEBHOOK_URL=https://api.medplum.com.ar/webhooks/mercadopago

# --- Anthropic (borrador de respuesta en Mensajes, Nivel 3) ---
# Lo lee el bot bw-borrador-respuesta desde los Project Secrets de Medplum (NO
# desde este .env: los bots corren en el servidor). Sin el secret, el botón
# "Sugerir" avisa que está desactivado y Recepción escribe a mano, como siempre.
# El borrador NUNCA se envía solo: lo manda una persona.
ANTHROPIC_API_KEY=

# --- Bus de Interoperabilidad del Ministerio de Salud (Federador de Pacientes) ---
# Los BOTS leen estos tres desde Project Secrets en Medplum, NO desde este .env.
# Acá están solo para `npm run federador:check`, que prueba la credencial contra
# el bus ANTES de cargarla en el servidor: así "no anda" deja de ser tres cosas
# distintas (secret word mal / secret sin cargar / bot sin deployar).
#
# ⚠️ QA es bus-test; producción es bus. El environment "VARIABLES QA" de Postman
# trae la URL de PRODUCCIÓN en `busUrl`, mientras que la colección de QA usa
# bus-test hardcodeado: copiar de ese archivo significa consultar el padrón
# nacional productivo con documentos reales creyendo que se está probando.
#   QA:          https://bus-test.msal.gob.ar
#   producción:  https://bus.msal.gob.ar
BUS_MSAL_URL=https://bus-test.msal.gob.ar
# La URL del dominio registrado en dominios.msal.gob.ar. Es el `iss` del JWT.
BUS_MSAL_ISSUER=https://api.medplum.com.ar
# La "token secret word" del dominio (dominios.msal.gob.ar → credenciales).
# Firma el client assertion HS256. NUNCA commitearla.
BUS_MSAL_SECRET=

# --- URLs base (Project Secrets de Medplum, leídas por los bots) ---
# Portal del paciente (la App). Destino del link de invitación, del reset de
# contraseña y del "volver al sitio" de MercadoPago (back_urls): quien paga un
# link de MP es el paciente, y tiene que volver a SU app, no a la de recepción.
PORTAL_BASE_URL=https://app.biowellness.ar
# APP_BASE_URL (la app de recepción) ya no la lee ningún bot (2026-09-20): las
# back_urls de MP la usaban y mandaban al paciente a la pantalla de login del
# personal. Si está cargada como Project Secret, es inerte.
