{
  "name": "@biowellness/recepcionistas",
  "version": "0.1.0",
  "private": true,
  "description": "Biowellness San Isidro — Herramienta de Recepción · Bloque 0 (Cimientos). Backend Medplum (FHIR R4).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "npm run typecheck --workspace @biowellness/recepcion-app",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/index.ts",
    "seed:prueba-recordatorios": "tsx src/seed/prueba-recordatorios.ts",
    "seed:prueba-espera": "tsx src/seed/prueba-espera.ts",
    "seed:prueba-agenda-semanal": "tsx src/seed/prueba-agenda-semanal.ts",
    "datos-demo": "tsx src/seed/datos-demo.ts",
    "demo:ocupacion": "tsx src/seed/demo-ocupacion.ts",
    "migrar:medios": "tsx src/seed/migrar-medio-pago.ts",
    "migrar:dni-renaper": "tsx src/seed/migrar-dni-renaper.ts",
    "limpiar": "tsx src/seed/limpiar.ts",
    "bots:bundle": "tsx src/seed/deploy-bots.ts --dry-run",
    "bots:check": "tsx src/seed/diagnostico-bots.ts",
    "bots:cron": "tsx src/seed/cron-bots.ts",
    "deploy:bots": "tsx src/seed/deploy-bots.ts",
    "email:test": "tsx src/seed/diagnostico-email.ts",
    "portal:check": "tsx src/seed/diagnostico-portal.ts",
    "mp:test": "tsx src/seed/diagnostico-mercadopago.ts",
    "mp:ordenes": "tsx src/seed/mp-ordenes.ts",
    "whatsapp:test": "tsx src/seed/diagnostico-whatsapp.ts",
    "medicos:consolidar": "tsx src/seed/consolidar-medicos.ts",
    "whatsapp:entregas": "tsx src/seed/diagnostico-entregas.ts",
    "whatsapp:plantilla": "tsx src/seed/diagnostico-plantilla.ts",
    "whatsapp:crear-plantillas": "tsx src/seed/crear-plantillas.ts",
    "qr:canales": "tsx src/seed/generar-qrs.ts",
    "crm:canales": "tsx src/seed/reporte-canales.ts",
    "agenda:check": "tsx src/seed/diagnostico-agenda.ts",
    "federador:check": "tsx src/seed/diagnostico-federador.ts",
    "catalogo:check": "tsx src/seed/diagnostico-catalogo.ts",
    "policy:check": "tsx src/seed/diagnostico-policies.ts",
    "disponibilidad:check": "tsx src/seed/diagnostico-disponibilidad.ts",
    "verify": "npm run typecheck && npm run typecheck:app && npm run test && npm run build:app",
    "dev": "npm run dev --workspace @biowellness/recepcion-app",
    "build:app": "npm run build --workspace @biowellness/recepcion-app",
    "app:typecheck": "npm run typecheck --workspace @biowellness/recepcion-app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@medplum/core": "5.1.24",
    "@medplum/fhirtypes": "5.1.24"
  },
  "devDependencies": {
    "@medplum/cli": "5.1.24",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
